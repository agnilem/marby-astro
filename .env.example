# All optional. Leave unset for a clean build.

# Form service URL (Formspree, Basin, Getform...). Unset: the form shows its
# states locally and sends nothing.
PUBLIC_FORM_ENDPOINT=

# "true" loads Vercel Web Analytics and Speed Insights.
PUBLIC_VERCEL_ANALYTICS=

# "true" shows the fixed store badge in the corner.
PUBLIC_STORE_BADGE=
