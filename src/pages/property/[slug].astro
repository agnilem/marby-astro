---
import Base from '../../layouts/Base.astro';
import Btn from '../../components/Btn.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/sections/Faq.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const items = await getCollection('properties');
  return items.map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
const d = p.data;
const prop = await site('property');
const settings = await site('settings');
const L = prop.labels;
const specs = [
  [L.area, d.area], [L.floors, d.floors], [L.bathrooms, d.bathrooms], [L.bedrooms, d.bedrooms],
  [L.location, d.location], [L.buildYear, d.buildYear], [L.price, d.price],
];
const rooms = (['bedroom', 'bathroom', 'kitchen', 'exterior'] as const).filter((r) => d.gallery[r].length);
const map = `https://maps.google.com/maps?q=${encodeURIComponent(d.location)}&z=15&output=embed`;
---
<Base
  title={`${d.name} — Marby Real Estate`}
  description={`${d.name} in ${d.location}. ${d.area}, ${d.buildYear}. View full details, gallery, and schedule a private showing.`}
  image={d.image}
>
  <section class="pd">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a class="t-body-sm link" href="/property">{L.crumb}</a>
      <span class="t-body-sm c-300">/</span>
      <span class="t-body-sm c-900 crumbs__current">{d.name}</span>
    </nav>

    <div class="pd__main">
      <div class="pd__name" data-appear="mount">
        <h1 class="t-h1">{d.name}</h1>
        <p class="t-caption2">{d.number}</p>
      </div>

      <div class="pd__top">
        <div class="pd__img1" data-appear="mount" style="--appear-delay:0.1s">
          <img src={d.image} alt={d.imageAlt} />
          <span class="pd__chip t-body-sm">{d.category}</span>
        </div>
        <div class="pd__side">
          <div class="pd__img2" data-appear="mount" style="--appear-delay:0.2s">
            <img src={d.secondaryImage} alt={d.secondaryImageAlt} />
            {rooms.length > 0 && (
              <button class="viewall" type="button" data-gallery-open>
                <svg width="15" height="15" viewBox="0 0 15 15" aria-hidden="true"><rect x="0.5" y="0.5" width="11" height="11" rx="2.5" fill="none" stroke="currentColor" /><path d="M3.5 14.5h8a3 3 0 0 0 3-3v-8" fill="none" stroke="currentColor" stroke-linecap="round" /></svg>
                <span class="t-body-sm c-900">{L.viewAll}</span>
              </button>
            )}
          </div>
          <dl class="specs" data-appear="mount" style="--appear-delay:0.3s">
            {specs.map(([k, v]) => (
              <div class="specs__row"><dt class="t-caption2">{k}</dt><dd class="t-body-sm c-900">{v}</dd></div>
            ))}
          </dl>
        </div>
      </div>

      <div class="pd__content">
        <div class="pd__left">
          <nav class="jump" data-jump data-jump-offset="140" aria-label="Sections" data-appear style="--appear-y:150px">
            <a class="jump__link t-body-sm is-active" href="#overview">{L.overview}</a>
            <a class="jump__link t-body-sm" href="#highlights">{L.highlights}</a>
            <a class="jump__link t-body-sm" href="#location">{L.locationTitle}</a>
          </nav>
          <div class="prose pd__desc" id="overview" data-appear style="--appear-y:150px"><Content /></div>
          <div class="pd__block" id="highlights" data-appear style="--appear-y:150px">
            <h2 class="t-h5 pd__label">{L.highlights}</h2>
            <ul class="hl">
              {[0, 2, 4, 1, 3, 5].map((i) => d.highlights[i]).filter(Boolean).map((h) => (
                <li class="hl__item"><span class="hl__check"><Icon name="check" /></span><span class="t-caption2 c-900">{h}</span></li>
              ))}
            </ul>
          </div>
          <div class="pd__block" id="location" data-appear style="--appear-y:150px">
            <h2 class="t-h5 pd__label">{L.locationTitle}</h2>
            <iframe class="pd__map" src={map} title={`Map of ${d.location}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            <dl class="near">
              {d.nearby.map((n) => (
                <div class="near__row"><dt class="t-caption2">{n.place}</dt><dd class="t-body-sm c-900">{n.time}</dd></div>
              ))}
            </dl>
          </div>
        </div>

        <aside class="pd__aside">
          <div class="advisor" data-appear style="--appear-ease:var(--ease-inout)">
            <img class="advisor__img" src={prop.advisor.image} alt={prop.advisor.imageAlt} loading="lazy" />
            <div class="advisor__body">
              <div class="advisor__name">
                <p class="t-caption2">{prop.advisor.label}</p>
                <p class="t-h5">{prop.advisor.name}</p>
              </div>
              <div class="advisor__contact">
                <a class="t-body-sm c-900" href={`tel:${prop.advisor.phone.replace(/[^+\d]/g, '')}`}>{prop.advisor.phone}</a>
                <a class="t-body-sm c-900" href={`mailto:${prop.advisor.email}`}>{prop.advisor.email}</a>
              </div>
            </div>
          </div>
          <div class="quiet" data-appear style="--appear-ease:var(--ease-inout)">
            <div class="quiet__name">
              <p class="t-caption2 c-300">{prop.quietList.label}</p>
              <p class="t-body-lg c-50">{prop.quietList.text}</p>
            </div>
            <Btn label={prop.quietList.cta.label} href={prop.quietList.cta.href} variant="secondary" />
          </div>
        </aside>
      </div>
    </div>
  </section>

  <Faq set="property" imageAlt={prop.faqImageAlt} fill tightPhone rowOnTablet />

  {rooms.length > 0 && (
    <div class="gallery" hidden data-gallery role="dialog" aria-modal="true" aria-label={`${d.name} photos`}>
      <div class="gallery__popup" data-jump-scroller data-lenis-prevent>
        <div class="gallery__top">
          <div class="gallery__bar">
            <button class="gallery__close" type="button" aria-label="Close gallery" data-gallery-close><Icon name="close" size={24} /></button>
            <Btn label={settings.consultation.label} href={settings.consultation.href} />
          </div>
          <nav class="jump jump--modal" data-jump data-jump-offset="170" aria-label="Rooms">
            {rooms.map((r, i) => <a class:list={['jump__link t-body-sm', { 'is-active': i === 0 }]} href={`#${r}`}>{L.rooms[r]}</a>)}
          </nav>
        </div>
        {rooms.map((r) => (
          <section class:list={['room', `room--${r}`]} id={r}>
            <h3 class="t-h3">{L.rooms[r]}</h3>
            <div class="room__grid">
              {d.gallery[r].map((src) => <img src={src} alt={`${d.name}, ${L.rooms[r]}`} loading="lazy" data-lightbox />)}
            </div>
          </section>
        ))}
      </div>
    </div>
  )}
</Base>

<style>
  .pd { padding: 40px 20px 80px; display: flex; flex-direction: column; align-items: center; gap: 40px; }
  .crumbs { width: 100%; max-width: var(--container); display: flex; align-items: center; gap: 4px; }
  .crumbs__current { max-width: 295px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pd__main { width: 100%; max-width: var(--container); display: flex; flex-direction: column; align-items: center; gap: 40px; }
  .pd__name { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 20px; border-radius: 8px; background: var(--ink-50); }
  .pd__name h1 { max-width: 600px; text-align: center; }

  .pd__top { width: 100%; display: flex; align-items: flex-start; gap: 20px; }
  .pd__img1 { position: relative; flex: 1 1 0; min-width: 0; height: 464px; border-radius: 8px; overflow: hidden; }
  .pd__img1 img, .pd__img2 img { width: 100%; height: 100%; object-fit: cover; }
  .pd__chip { position: absolute; left: 20px; top: 20px; padding: 4px 8px; border-radius: 4px; background: var(--ink-50); }
  .pd__side { flex: 1 1 0; min-width: 0; max-width: 340px; height: 464px; display: flex; flex-direction: column; gap: 40px; }
  .pd__img2 { position: relative; flex: 1; min-height: 0; border-radius: 8px; overflow: clip; }
  .viewall {
    position: absolute;
    right: 20px;
    bottom: 20px;
    height: 28px;
    padding: 4px 8px;
    border-radius: 4px;
    background: var(--ink-50);
    color: var(--ink-900);
    display: flex;
    align-items: center;
    gap: 8px;
    transition: background-color var(--spring-04-dur) var(--spring-04);
  }
  .viewall:hover { background: var(--white); }
  .specs, .near { margin: 0; width: 100%; display: flex; flex-direction: column; }
  .specs__row, .near__row { display: flex; align-items: center; gap: 10px; padding: 4px 0 8px; box-shadow: inset 0 -1px 0 var(--ink-200); }
  .specs__row:last-child { box-shadow: none; }
  .specs__row dt, .near__row dt { flex: 1; }
  .near__row { gap: 100px; }
  dd { margin: 0; text-align: right; }

  .pd__content { width: 100%; display: flex; align-items: flex-start; justify-content: center; gap: 20px; }
  .pd__left { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 40px; }
  .jump { position: sticky; top: 76px; z-index: 2; width: 100%; display: flex; gap: 4px; padding: 4px; border-radius: 12px; background: var(--ink-50); }
  .jump__link { flex: 1; display: flex; justify-content: center; padding: 8px 12px; border-radius: 8px; background: var(--white); color: var(--ink-900); transition: background-color var(--spring-04-dur) var(--spring-04), color var(--spring-04-dur) var(--spring-04); }
  .jump__link.is-active { background: var(--ink-950); color: var(--ink-50); }
  .pd__desc { max-width: 700px; scroll-margin-top: 116px; }
  .pd__block { width: 100%; max-width: 780px; display: flex; flex-direction: column; gap: 20px; scroll-margin-top: 116px; }
  .pd__label { padding-bottom: 20px; box-shadow: inset 0 -1px 0 var(--ink-200); }
  .hl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .hl__item { display: flex; align-items: center; gap: 10px; }
  .hl__item > .t-caption2 { width: 204.67px; flex: none; }
  .hl__check { flex: none; display: grid; place-items: center; padding: 8px; border-radius: 4px; background: var(--ink-50); color: var(--ink-900); }
  .pd__map { width: 100%; height: 400px; border: 0; border-radius: 8px; }

  .pd__aside { flex: 1 1 0; max-width: 340px; position: sticky; top: 76px; display: flex; flex-direction: column; gap: 20px; }
  .advisor { display: flex; align-items: stretch; gap: 20px; padding: 20px; border-radius: 8px; background: var(--ink-50); }
  .advisor__img { width: 109px; flex: none; contain: size; object-fit: cover; border-radius: 8px; }
  .advisor__body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .advisor__name { display: flex; flex-direction: column; gap: 8px; }
  .advisor__contact { height: 66px; display: flex; flex-direction: column; gap: 8px; padding-block: 12px; }
  .quiet { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; padding: 20px; border-radius: 8px; background: var(--ink-950); }
  .quiet__name { display: flex; flex-direction: column; gap: 8px; }

  /* photo gallery modal */
  .gallery { position: fixed; inset: 0; z-index: 6; background: rgba(27, 27, 40, 0.4); display: flex; justify-content: center; opacity: 0; }
  .gallery[hidden] { display: none; }
  .gallery.is-open { opacity: 1; transition: opacity 0.3s var(--ease-overlay); }
  .gallery__popup {
    width: 100%;
    max-width: var(--container);
    height: 100vh;
    overflow: auto;
    overscroll-behavior: contain;
    padding: 0 40px 80px;
    border-radius: 8px;
    background: var(--ink-50);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    transform: scale(0.98);
  }
  .gallery.is-open .gallery__popup { transform: none; transition: transform var(--spring-04-dur) var(--spring-04); }
  .gallery__top { position: sticky; top: 0; z-index: 1; width: 100%; padding-top: 40px; background: var(--ink-50); display: flex; flex-direction: column; align-items: center; gap: 40px; }
  .gallery__bar { width: 1000px; max-width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 40px; }
  .gallery__close { width: 24px; height: 24px; color: var(--ink-900); }
  .jump--modal { position: static; width: auto; }
  .jump--modal .jump__link { flex: none; }
  .room { width: 1000px; max-width: 100%; display: flex; flex-direction: column; gap: 20px; scroll-margin-top: 170px; }
  .room__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .room__grid img { width: 100%; height: 300px; object-fit: cover; border-radius: 12px; cursor: zoom-in; }
  .room--bedroom .room__grid { display: flex; }
  .room--bedroom .room__grid img { flex: 1 1 0; min-width: 0; height: 400px; }
  .room--exterior .room__grid { row-gap: 10px; }
  .room--exterior .room__grid img:last-child { grid-column: 1 / -1; height: 520px; }
  :global(.lightbox) { position: fixed; inset: 0; z-index: 20; display: grid; place-items: center; padding: 20px; background: rgba(27, 27, 40, 0.4); cursor: zoom-out; opacity: 0; }
  :global(.lightbox[hidden]) { display: none; }
  :global(.lightbox.is-open) { opacity: 1; transition: opacity var(--spring-04-dur) var(--spring-04); }
  :global(.lightbox img) { max-width: min(1000px, 100%); max-height: 100%; border-radius: 12px; }

  @media (max-width: 1199.98px) {
    .pd { padding-bottom: 40px; }
    .gallery__popup { padding: 0 20px 20px; gap: 32px; align-items: flex-start; }
    .gallery__top { padding-top: 20px; }
    .gallery__bar, .room { width: 100%; }
    .room__grid { gap: 10px; }
    .room__grid img, .room--bedroom .room__grid img { height: 240px; }
    .room--exterior .room__grid { display: flex; flex-direction: column; }
    .room--exterior .room__grid img:last-child { height: 240px; }
    .hl { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 809.98px) {
    .pd__name { justify-content: flex-start; gap: 20px; }
    .pd__name h1 { flex: 1; text-align: left; }
    .pd__top, .pd__content { flex-direction: column; align-items: stretch; }
    .pd__content { gap: 40px; }
    .pd__side { max-width: none; flex: none; }
    .pd__img1 { flex: none; }
    .pd__left { align-items: center; position: relative; }
    .pd__aside { position: relative; top: auto; max-width: none; }
    .jump__link { height: 42px; padding: 8px 16px; align-items: center; }
    .hl__item > .t-caption2 { width: auto; flex: 1; }
    .quiet { flex-direction: column; }
    .gallery__popup { align-items: center; }
    .jump--modal { width: 100%; overflow-x: auto; }
    .room--bedroom .room__grid { flex-direction: column; }
    .room--bedroom .room__grid img { flex: none; height: 320px; }
    .room__grid { display: flex; flex-direction: column; gap: 16px; }
    .room__grid img { height: 220px; }
    .room--exterior .room__grid { display: grid; gap: 10px 16px; }
    .room--exterior .room__grid img:last-child { height: 360px; }
  }
  @media (max-width: 480px) {
    .room--exterior .room__grid img:last-child { height: 280px; }
  }
</style>
