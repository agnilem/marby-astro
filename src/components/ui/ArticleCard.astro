---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../../lib/site';
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const d = post.data;
---
<a class="acard" href={`/blog/${post.id}`} data-filter-item data-tags={d.category} data-name={d.title}>
  <div class="acard__media">
    <img src={d.image} alt={d.imageAlt} loading="lazy" decoding="async" />
    <span class="acard__tag t-body-sm">{d.category}</span>
  </div>
  <div class="acard__text">
    <h3 class="t-h5 acard__title">{d.title}</h3>
    <p class="t-caption c-600"><time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></p>
  </div>
</a>
<style>
  .acard { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .acard__media { position: relative; aspect-ratio: 1.25; border-radius: 8px; overflow: clip; }
  .acard__media img {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
    transform: translate(-50%, -50%);
    transition: width var(--spring-04-dur) var(--spring-04), height var(--spring-04-dur) var(--spring-04);
  }
  .acard__tag { position: absolute; left: 20px; top: 20px; padding: 4px 8px; border-radius: 4px; background: var(--ink-50); color: var(--ink-600); }
  .acard__text { display: flex; flex-direction: column; gap: 8px; padding: 8px 20px; border-radius: 8px; background: var(--ink-50); }
  .acard__title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-wrap: nowrap; }
  @media (hover: hover) and (min-width: 1200px) {
    .acard:hover .acard__media img { width: 110%; height: 110%; }
  }
</style>
