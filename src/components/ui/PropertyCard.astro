---
import Icon from '../Icon.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { p: CollectionEntry<'properties'>; eager?: boolean }
const { p, eager = false } = Astro.props;
const d = p.data;
const rows = [['AREA', d.area], ['LOCATION', d.location], ['BEDROOMS', d.bedrooms], ['PRICE', d.price]];
---
<a class="pcard" href={`/property/${p.id}`} data-filter-item data-tags={d.category} data-name={d.name}>
  <div class="pcard__media">
    <img src={d.image} alt={d.imageAlt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    <div class="pcard__bar">
      <span class="pcard__chip t-body-sm c-900">{d.category}</span>
      <span class="btn btn--icon" aria-hidden="true"><span class="btn__icon"><Icon name="arrow" /></span></span>
    </div>
  </div>
  <div class="pcard__name">
    <h3 class="t-h5">{d.name}</h3>
    <p class="t-caption">{d.number}</p>
  </div>
  <dl class="pcard__list">
    {rows.map(([k, v]) => (
      <div class="pcard__row">
        <dt class="t-caption2">{k}</dt>
        <dd class="t-body-sm c-900">{v}</dd>
      </div>
    ))}
  </dl>
</a>
<style>
  .pcard { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .pcard__media { position: relative; aspect-ratio: 1.24; border-radius: 8px; overflow: clip; }
  .pcard__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 8px; }
  .pcard__bar {
    position: absolute;
    inset: auto 0 0 0;
    height: 63px;
    padding: 20px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    background: linear-gradient(0deg, rgba(20, 27, 52, 0.15) 0%, rgba(0, 0, 0, 0) 100%);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity var(--spring-04-dur) var(--spring-04);
  }
  .pcard__chip { padding: 4px 8px; border-radius: 4px; background: var(--ink-50); }
  .pcard__name {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 20px;
    border-radius: 8px;
    background: var(--ink-50);
    overflow: clip;
  }
  .pcard__list { margin: 0; padding: 0 20px; display: flex; flex-direction: column; }
  .pcard__row { display: flex; align-items: center; justify-content: space-between; gap: 100px; padding: 4px 0 8px; box-shadow: inset 0 -1px 0 var(--ink-200); }
  .pcard__row:last-child { box-shadow: none; }
  .pcard__row dt { flex: 1; }
  .pcard__row dd { margin: 0; text-align: right; }
  @media (hover: hover) and (min-width: 1200px) {
    .pcard:hover .pcard__bar { opacity: 1; }
  }
</style>
