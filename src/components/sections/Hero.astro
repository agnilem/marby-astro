---
import { site } from '../../lib/site';
const { hero } = await site('home');
---
<section class="hero" data-dark>
  <video class="hero__video" src={hero.video} poster={hero.poster} autoplay muted loop playsinline preload="auto" aria-hidden="true"></video>
  <div class="scrim" aria-hidden="true"></div>
  <div class="container hero__inner">
    <h1 class="hero__title" data-appear="mount">{hero.title}</h1>
    <p class="hero__text t-caption2 c-200" data-appear="mount" style="--appear-delay:0.2s">{hero.text}</p>
  </div>
</section>
<style>
  .hero {
    position: relative;
    height: 95vh;
    overflow: clip;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--ink-900);
  }
  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
    padding-bottom: 32px;
  }
  .hero__title {
    width: 100%;
    font-size: var(--wordmark);
    font-weight: 500;
    line-height: 1.2;
    color: var(--ink-50);
  }
  .hero__text { width: 460px; max-width: 100%; }
  @media (min-width: 1200px) { .hero__title { width: 1158px; max-width: 100%; } }
  @media (max-width: 1199.98px) { .hero { height: 600px; } }
  @media (max-width: 809.98px) {
    .hero__inner { align-items: flex-start; }
    .hero__text { width: 100%; }
  }
</style>
