---
import Btn from '../Btn.astro';
import QuestionRow from '../ui/QuestionRow.astro';
import { site } from '../../lib/site';
interface Props { set?: 'general' | 'property'; imageAlt?: string; fill?: boolean; tightPhone?: boolean; rowOnTablet?: boolean }
const { set = 'general', imageAlt, fill = false, tightPhone = false, rowOnTablet = false } = Astro.props;
const faq = await site('faq');
const items = faq[set];
---
<section class:list={['faq', { 'faq--tight': tightPhone, 'faq--row': rowOnTablet }]}>
  <div class="container faq__inner">
    <div class="faq__head">
      <div class="faq__title">
        <p class="t-caption2" data-appear>{faq.label}</p>
        <h2 class="t-h2" data-appear style="--appear-delay:0.1s">{faq.title}</h2>
      </div>
      <div class="faq__side">
        <p class="t-body-sm" data-appear style="--appear-delay:0.2s">{faq.text}</p>
        <div data-appear style="--appear-delay:0.3s"><Btn label={faq.cta.label} href={faq.cta.href} /></div>
      </div>
    </div>
    <div class="faq__body">
      <div class="faq__list" data-accordion>
        {items.map((it: any, i: number) => <QuestionRow n={i + 1} q={it.q} a={it.a} delay={0.4 + i * 0.1} />)}
      </div>
      <div class:list={['faq__media', { 'faq__media--fill': fill }]} data-appear style="--appear-delay:0.4s">
        <img class="faq__img" src={faq.image} alt={imageAlt ?? faq.imageAlt} loading="lazy" />
      </div>
    </div>
  </div>
</section>
<style>
  .faq { background: var(--white); padding-block: 80px; }
  .faq__inner { display: flex; flex-direction: column; gap: 40px; }
  .faq__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; }
  .faq__title { flex: 1; max-width: 460px; display: flex; flex-direction: column; gap: 12px; }
  .faq__side { flex: 1; max-width: 460px; display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .faq__body { display: flex; align-items: flex-start; gap: 40px; }
  .faq__list { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 40px; }
  .faq__media { position: relative; flex: 1 1 0; min-width: 0; height: 404px; }
  /* on the property page the image matches the height of the question list */
  .faq__media--fill { align-self: stretch; height: auto; }
  .faq__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 8px; }
  @media (max-width: 1199.98px) {
    .faq:not(.faq--row) .faq__head { flex-direction: column; align-items: flex-start; justify-content: flex-start; }
    .faq__side { max-width: 460px; width: 100%; }
    .faq__media { display: none; }
  }
  /* the property page's FAQ has no inner gutter, so it runs 40px wider */
  .faq--row .container { max-width: calc(var(--container) + 40px); }
  @media (max-width: 809.98px) {
    .faq--tight { padding-block: 40px; }
    .faq--row .faq__head { flex-direction: column; align-items: flex-start; gap: 0; }
    .faq__title, .faq__side { max-width: none; width: 100%; }
  }
</style>
