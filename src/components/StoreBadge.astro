---
// Demo-only badge linking to where the template is sold. Hidden unless
// PUBLIC_STORE_BADGE=true, so a fresh clone ships without it.
const on = import.meta.env.PUBLIC_STORE_BADGE === 'true';
const arrow =
  '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>';
---
{on && (
  <a class="badge" href="https://startfrom.co/" target="_blank" rel="noopener">
    <span class="badge__label">GET MARBY</span>
    <span class="badge__mask">
      <span class="badge__out" set:html={arrow} />
      <span class="badge__in" set:html={arrow} />
    </span>
  </a>
)}
<style>
  .badge {
    position: fixed;
    right: 20px;
    bottom: 66px;
    z-index: 10;
    width: 140px;
    height: 38px;
    padding: 4px 4px 4px 10px;
    border-radius: 4px;
    background: rgb(27, 27, 40);
    display: flex;
    align-items: center;
    justify-content: space-between;
    overflow: clip;
    transition: transform 0.12s var(--ease-badge);
  }
  .badge:active { transform: scale(0.98); }
  .badge__label {
    font-family: var(--font-caption);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.03em;
    line-height: 1;
    color: var(--ink-50);
  }
  .badge__mask {
    position: relative;
    width: 30px;
    height: 30px;
    border-radius: 2px;
    background: rgba(245, 245, 246, 0.08);
    overflow: clip;
    color: var(--ink-50);
  }
  .badge__out, .badge__in {
    position: absolute;
    width: 14px;
    height: 14px;
    transition: transform 0.16s var(--ease-badge), opacity 0.16s var(--ease-badge);
  }
  .badge__out { left: 8px; top: 8px; }
  .badge__in { left: 8px; top: 8px; opacity: 0; transform: translate(-6px, 6px); }
  .badge:hover .badge__out { opacity: 0; transform: translate(6px, -6px); }
  .badge:hover .badge__in { opacity: 1; transform: none; }
</style>
